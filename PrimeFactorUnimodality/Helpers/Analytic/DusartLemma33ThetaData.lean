theorem dusart_theta_nat_2 :
    Chebyshev.theta (2 : Real) =
      ∑ p ∈ ({2} : Finset Nat), Real.log p := by
  have h := Chebyshev.theta_eq_sum_primesLE_log 2
  have hp : Nat.primesLE 2 = {2} := by decide
  rw [hp] at h
  simpa using h

